{
  "name": "dsh-plugin-local-machine",
  "version": "2.1.0",
  "description": "Local system dashboard: CPU, memory, GPU, disk, network, sensors, and top processes, plus DSH process-tree, per-thread, and per-session monitoring.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cpu",
    "memory",
    "gpu",
    "disk",
    "network",
    "processes",
    "system-monitor",
    "sessions",
    "sidebar",
    "macos",
    "windows",
    "linux"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/swjybky/dsh-local-machine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swjybky/dsh-local-machine.git"
  },
  "bugs": {
    "url": "https://github.com/swjybky/dsh-local-machine/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "index": "node scripts/make-index.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
